# Auto-detect text files and normalize line endings
* text=auto

# Source code — always LF
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf
*.css         text eol=lf
*.json        text eol=lf
*.html        text eol=lf
*.md          text eol=lf

# Config files — LF
*.yaml        text eol=lf
*.yml         text eol=lf
*.toml        text eol=lf
*.env         text eol=lf
*.env.*       text eol=lf

# Shell scripts — LF
*.sh          text eol=lf

# Batch scripts — CRLF
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Docker
Dockerfile    text eol=lf
.dockerignore text eol=lf

# Images — binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.svg         text eol=lf
*.webp        binary

# Fonts — binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.eot         binary

# Lock files — do not diff
bun.lock      linguist-generated
