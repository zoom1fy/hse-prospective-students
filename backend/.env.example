# PostgreSQL connection settings for the HSE Prospective Students backend.
# Copy this file to .env and adjust values to your local database.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hse_prospective_students
DB_USER=postgres
DB_PASSWORD=postgres

# JWT settings. Generate a strong SECRET_KEY, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256