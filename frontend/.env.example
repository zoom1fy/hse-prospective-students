# URL backend API for browser requests. Пусто — используются относительные /api (через rewrite/nginx)
NEXT_PUBLIC_API_URL=

# Внутренний URL backend для server-side запросов в Docker (например, http://backend:8000).
# Только для сервера, в браузер не попадает.
API_INTERNAL_URL=

# Public base URL of the site, used for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
